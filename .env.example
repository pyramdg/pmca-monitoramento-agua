# ========== VARIÁVEIS DE AMBIENTE ==========
# Copie este arquivo para .env e configure com seus valores reais
# NÃO COMMITE .env NO GIT!

# Ambiente
ENV=development

# Banco de dados
# SQLite (local): sqlite:///./pmca.db
# PostgreSQL: postgresql://user:password@localhost:5432/pmca
DATABASE_URL=sqlite:///./pmca.db

# Segurança - MUDE EM PRODUÇÃO!
# Gerar com: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=seu-secret-key-muito-seguro-aqui-mudeme

# Administrador inicial (opcional)
ADMIN_EMAIL=admin@pmca.local
# ADMIN_PASSWORD=defina-uma-senha-segura-antes-da-primeira-migracao

# CORS - Origins permitidas
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:5000

# 0 = a chave do aparelho não expira; ela só deixa de valer ao ser trocada.
API_KEY_EXPIRATION=0
